{
  "manifest_version": 3,
  "name": "PVZGE Sync",
  "version": "2026.6.16",
  "description": "Sync PVZGE game save data across browsers via Gist or JSON",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://play.pvzge.com/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.pvzge.com/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
